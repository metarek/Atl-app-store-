rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function for admin check against firestore
    function isAdmin() {
      return request.auth != null && 
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Public read for downloadable APK files and app media
    match /apks/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
